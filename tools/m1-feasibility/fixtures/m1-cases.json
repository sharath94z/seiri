  {
    "id": "move-date-folders",
    "name": "Move with date folders",
    "goal": "Verify date-folder destination shaping can be described for later engine comparison.",
    "status": "ready",
    "expectedCompatibility": "wrapper",
    "requiredCapabilities": ["dateFolder", "move"],
    "sampleFile": {
      "name": "Receipt-2026-05-17.pdf",
