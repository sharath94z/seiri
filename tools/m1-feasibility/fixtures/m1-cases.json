    },
    "ruleSet": [
      {
        "id": "date-folder-receipts",
        "priority": 1,
        "conditionLogic": "all",
        "conditions": [
          {
            "field": "extension",
            "operator": "is",
            "value": "pdf"
          }
        ],
        "action": {
