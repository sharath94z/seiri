  {
    "id": "source-url-provenance",
    "name": "Source URL provenance",
    "goal": "Verify source URL matching remains in Seiri's public rule model even when organize cannot do it natively.",
    "status": "ready",
    "expectedCompatibility": "wrapper",
    "requiredCapabilities": ["sourceUrlProvenance", "extension", "move"],
    "sampleFile": {
      "name": "DownloadFromBrowser.zip",
      "sourcePath": "~/Downloads/DownloadFromBrowser.zip",
      "sourceUrl": "https://github.com/openai/seiri/releases/download/latest/DownloadFromBrowser.zip"
    },
    "ruleSet": [
      {
        "id": "move-browser-downloads",
        "priority": 1,
        "conditionLogic": "all",
        "conditions": [
          {
            "field": "source_url_contains",
            "operator": "contains",
            "value": "github.com"
          },
          {
            "field": "extension",
            "operator": "is",
            "value": "zip"
          }
        ],
        "action": {
          "type": "move",
          "destination": "~/Documents/Browser Downloads/"
        }
      }
    ],
    "expectedOutcome": "Browser-origin downloads should be prefiltered before the organize config runs.",
    "evidence": "Organize does not document source URL provenance as a native filter, so Seiri must handle it in the wrapper."
  }
