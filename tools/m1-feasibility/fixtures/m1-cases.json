[
  {
    "id": "simple-extension-match",
    "name": "Simple extension match",
    "goal": "Verify a single extension rule can identify PDF files.",
    "status": "ready",
    "expectedCompatibility": "native",
    "requiredCapabilities": ["extension", "move"],
    "sampleFile": {
      "name": "Invoice-April.pdf",
      "sourcePath": "~/Downloads/Invoice-April.pdf"
    },
    "ruleSet": [
      {
        "id": "move-pdfs",
        "priority": 1,
        "conditionLogic": "all",
        "conditions": [
          {
            "field": "extension",
            "operator": "is",
            "value": "pdf"
          }
        ],
        "action": {
          "type": "move",
          "destination": "~/Documents/PDFs/"
        }
      }
    ],
    "expectedOutcome": "Move PDF files into the PDFs folder.",
    "evidence": "Organize supports file extension filters and move actions directly."
  },
  {
    "id": "ordered-rule-evaluation",
    "name": "Ordered rule evaluation",
    "goal": "Verify first-match precedence is preserved when multiple rules can match.",
    "status": "ready",
    "expectedCompatibility": "wrapper",
    "requiredCapabilities": ["orderedEvaluation", "extension", "move"],
    "sampleFile": {
      "name": "Receipt.pdf",
      "sourcePath": "~/Downloads/Receipt.pdf"
    },
    "ruleSet": [
      {
        "id": "move-pdfs",
        "priority": 1,
        "conditionLogic": "all",
        "conditions": [
          {
            "field": "extension",
            "operator": "is",
            "value": "pdf"
          }
        ],
        "action": {
          "type": "move",
          "destination": "~/Documents/PDFs/"
        }
      },
      {
        "id": "move-all-downloads",
        "priority": 2,
        "conditionLogic": "all",
        "conditions": [
          {
            "field": "folder",
            "operator": "contains",
            "value": "Downloads"
          }
        ],
        "action": {
          "type": "move",
          "destination": "~/Documents/Archive/"
        }
      }
    ],
    "expectedOutcome": "The PDF rule should win before the broader fallback rule.",
    "evidence": "Organize is ordered, but Seiri needs wrapper enforcement if we want explicit first-match-stop behavior."
  },
  {
    "id": "nested-or",
    "name": "Nested OR groups",
    "goal": "Verify nested disjunctions can be represented without collapsing rule intent.",
    "status": "ready",
    "expectedCompatibility": "wrapper",
    "requiredCapabilities": ["nestedBoolean", "extension", "move"],
    "sampleFile": {
      "name": "Screenshot.png",
      "sourcePath": "~/Downloads/Screenshot.png"
    },
    "ruleSet": [
      {
        "id": "move-images",
        "priority": 1,
        "conditionLogic": "all",
        "conditions": [
          {
            "conditionLogic": "any",
            "conditions": [
              {
                "field": "extension",
                "operator": "is",
                "value": "png"
              },
              {
                "field": "extension",
                "operator": "is",
                "value": "jpg"
              }
            ]
          },
          {
            "field": "filename",
            "operator": "starts_with",
            "value": "Screenshot"
          }
        ],
        "action": {
          "type": "move",
          "destination": "~/Documents/Screenshots/"
        }
      }
    ],
    "expectedOutcome": "Screenshot images should be grouped by nested OR logic before moving.",
    "evidence": "Organize only exposes flat all/any/none grouping, so Seiri must normalize its tree."
  },
  {
    "id": "not-exclusion",
    "name": "NOT / exclusion behavior",
    "goal": "Verify negative conditions can exclude files from a matching rule.",
    "status": "ready",
    "expectedCompatibility": "wrapper",
    "requiredCapabilities": ["negation", "extension", "move"],
    "sampleFile": {
      "name": "Screenshot_2026-05-17.png",
      "sourcePath": "~/Downloads/Screenshot_2026-05-17.png"
    },
    "ruleSet": [
      {
        "id": "move-non-screenshots",
        "priority": 1,
        "conditionLogic": "all",
        "conditions": [
          {
            "field": "extension",
            "operator": "is",
            "value": "png"
          },
          {
            "field": "filename",
            "operator": "starts_with",
            "value": "Screenshot",
            "negate": true
          }
        ],
        "action": {
          "type": "move",
          "destination": "~/Documents/Images/"
        }
      }
    ],
    "expectedOutcome": "Regular PNGs move; screenshot PNGs are excluded.",
    "evidence": "Negation is available in organize, but Seiri still needs wrapper logic for its nested rule trees."
  },
